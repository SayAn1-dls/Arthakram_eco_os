# Path to the SQLite database file (created by `npm run db:migrate`).
DATABASE_PATH=./storage/arthakram.db
# Directory where uploaded files are stored.
UPLOAD_DIR=./storage/uploads
# Public base URL, used to build QR code links.
APP_URL=http://localhost:3000
# Links to Arthakram's separate products (shown on the Learn page; editable by admins later).
PRODUCT_GUYS_URL=
CONSULTING_URL=
